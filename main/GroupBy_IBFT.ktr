  <step>
    <name>Modified - Status field</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var missingTypes = [];
var duplicateTypes = [];

// kiem tra missing value
if (DEP_REQ_count == 0) {
    missingTypes.push("SGB_IBFT_DEP_REQ");
}

if (DepositRequest_count == 0) {
    missingTypes.push("IBFTDepositRequest");
}

if (DepositResponse_count == 0) {
    missingTypes.push("IBFTDepositResponse");
}

if (DEP_RES_count == 0) {
    missingTypes.push("SGB_IBFT_DEP_RES");
}

// kiem tra duplicate
if (DEP_REQ_count > 1) {
    duplicateTypes.push("SGB_IBFT_DEP_REQ x" + DEP_REQ_count);
}

if (DepositRequest_count > 1) {
    duplicateTypes.push("IBFTDepositRequest x" + DepositRequest_count);
}

if (DepositResponse_count > 1) {
    duplicateTypes.push("IBFTDepositResponse x" + DepositResponse_count);
}

if (DEP_RES_count > 1) {
    duplicateTypes.push("SGB_IBFT_DEP_RES x" + DEP_RES_count);	
}

var hasMissing = missingTypes.length > 0;
var hasDuplicate = duplicateTypes.length > 0;

var status;

if (hasMissing &amp;&amp; hasDuplicate) {
    status = "Missing and Duplicate (Missing: " + missingTypes.join(", ")+"; Duplicate: " + duplicateTypes.join(", ") + ")";
}
else if (hasMissing) {
    status = "Missing Value (" + missingTypes.join(", ") + ")";
}
else if (hasDuplicate) {
    status = "Duplicate Value (" + duplicateTypes.join(", ") + ")";
}
else {
    status = "Complete";
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>status</name>
        <rename>status</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
