, accountdestnumber
, currencycode
, accounttype
, accountsourcenumber
, channel
, channelcode
, description
, f37
, approvecode
, datesettlement
, responsecode
, short_filename
, loaded_at
, accountsourcename
, accountsourceaddress
, accountdestname
FROM "public".stg_event
</sql>
