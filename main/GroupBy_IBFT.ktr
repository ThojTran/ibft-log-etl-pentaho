    <sql>SELECT
  log_header
, request_type
, tracenumber
, pan
, transactionamount
, transmissiondateandtime
, timelocaltranx
, datelocaltranx
, merchanttype
, entrymodecode
, serviceconditioncode
, acceptingidcode
, referencenumber
, terminalid
, merchantid
, merchantname
, merchantlocation
, ibfttype
, bankcode
