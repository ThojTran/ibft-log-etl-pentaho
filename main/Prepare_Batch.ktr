    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var load_action;

if (existing_batch_id == null) {
    // new batch_id
    load_action = "NEW";
}
else if (existing_completed_at == null) {
    // have batch but do not see completed_at
    load_action = "RETRY";
}
else {
    // have batch và completed_at
    load_action = "SKIP";
}
</jsScript_script>
      </jsScript>
